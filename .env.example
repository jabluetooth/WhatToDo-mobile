# Base URL of the WhatToDo Next.js backend.
# - `expo start --web` on the same machine as `pnpm dev`: http://localhost:3000 works as-is.
# - Expo Go on a physical device/emulator: use your machine's LAN IP, e.g. http://192.168.1.23:3000
#   (adb reverse can also forward an Android emulator's localhost:8081-style setup, but the
#   simplest fix for API calls specifically is just using the LAN IP here).
# - Production builds: point this at the deployed backend, e.g. https://whattodoby.filheinzrelatorre.com
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
